{
	"schemaVersion": 1,
	"id": "throwspawn",
	"version": "${version}",
	"name": "Throwable Spawn Eggs",
	"description": "Ever wondered why spawn eggs in Minecraft doesn't behave the same way as plain eggs? this mod exactly fixes that gap!",
	"authors": [
		"remonilo"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/throwspawn/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.remonilo.throwspawn.ThrowableSpawnEggs"
		],
		"client": [
			"com.remonilo.throwspawn.client.ThrowableSpawnEggsClient"
		],
		"fabric-datagen": [
			"com.remonilo.throwspawn.client.ThrowableSpawnEggsDataGenerator"
		]
	},
	"mixins": [
		"throwspawn.mixins.json",
		{
			"config": "throwspawn.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}